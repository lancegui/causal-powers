#!/usr/bin/env bash
# SessionStart + PreCompact hook for causal-powers resumability.
#
# Durable state now lives in docs/analysis/index.yaml plus the small YAML records
# it names. The hook injects only a compact snapshot so fresh/compacted sessions
# resume instead of restarting. Legacy analysis-plan.md is supported only as a
# migration signal.

set -uo pipefail

case ",${CAUSAL_POWERS_DISABLED_HOOKS:-}," in *",plan-resume,"*) exit 0 ;; esac

payload="$(cat 2>/dev/null || true)"

event="$(printf '%s' "$payload" \
  | grep -oE '"hook_event_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
  | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')"
event="${event:-SessionStart}"

state_index=""
legacy_plan=""
for dir in "${PWD:-.}" "${CLAUDE_PROJECT_DIR:-}"; do
  [ -n "$dir" ] || continue
  if [ -f "${dir}/docs/analysis/index.yaml" ]; then
    state_index="${dir}/docs/analysis/index.yaml"
    break
  fi
  if [ -z "$legacy_plan" ] && [ -f "${dir}/analysis-plan.md" ]; then
    legacy_plan="${dir}/analysis-plan.md"
  fi
  if [ -z "$legacy_plan" ] && [ -f "${dir}/docs/analysis-plan.md" ]; then
    legacy_plan="${dir}/docs/analysis-plan.md"
  fi
done

[ -n "$state_index" ] || [ -n "$legacy_plan" ] || exit 0

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

sanitize_excerpt() {
  printf '%s' "$1" \
    | sed -e 's;</system-reminder>;;g' -e 's;<system-reminder>;;g' \
    | head -c 260
}

emit() {
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$1" "$2"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$2"
  fi
  exit 0
}

if [ -z "$state_index" ]; then
  if [ "$event" = "PreCompact" ]; then
    msg="<system-reminder>
RESUMABILITY - legacy analysis plan exists at ${legacy_plan}. Before compaction,
flush current state and migrate the resume surface to docs/analysis/index.yaml
plus small YAML records. Do not rely on rereading the whole legacy plan after
compaction.
</system-reminder>"
  else
    msg="<system-reminder>
RESUMABILITY - legacy analysis plan exists at ${legacy_plan}. Read only the
section needed to recover current state, then invoke analysis-state-management
and create docs/analysis/index.yaml so future sessions do not reread the whole
plan.
</system-reminder>"
  fi
  emit "$event" "$(escape_for_json "$msg")"
fi

base_dir="$(dirname "$state_index")"

yaml_value() {
  # yaml_value <file> <key> - shallow key only, no dependency on yq/jq.
  [ -r "$1" ] || return 0
  grep -m1 -E "^[[:space:]]*$2:[[:space:]]*" "$1" \
    | sed -E "s/^[[:space:]]*$2:[[:space:]]*//" \
    | sed -E 's/^["'\'']|["'\'']$//g'
}

resolve_record() {
  local rel="$1"
  [ -n "$rel" ] || return 0
  case "$rel" in
    /*) printf '%s' "$rel" ;;
    *) printf '%s/%s' "$base_dir" "$rel" ;;
  esac
}

current_rel="$(yaml_value "$state_index" current)"
decisions_rel="$(yaml_value "$state_index" decisions)"
current_file="$(resolve_record "$current_rel")"
decisions_file="$(resolve_record "$decisions_rel")"

active_phase="$(yaml_value "$state_index" active_phase)"
current_phase="$(yaml_value "$current_file" phase)"
status="$(yaml_value "$current_file" status)"
next_action="$(yaml_value "$current_file" next_action)"
updated="$(yaml_value "$current_file" updated)"

[ -n "$active_phase" ] || active_phase="$current_phase"
[ -n "$active_phase" ] || active_phase="unknown"
[ -n "$status" ] || status="unknown"
[ -n "$next_action" ] || next_action="read docs/analysis/index.yaml and current.yaml, then continue"

latest_decision=""
if [ -r "$decisions_file" ]; then
  latest_decision="$(grep -E '^[[:space:]]*(decision|id):[[:space:]]*' "$decisions_file" 2>/dev/null | tail -2 | tr '\n' '; ' | sed 's/[[:space:]]*$//')"
fi

read_list="$(awk '
  /^[[:space:]]*read_for_current_task:[[:space:]]*$/ { in_list=1; next }
  in_list && /^[[:space:]]*-[[:space:]]+/ { sub(/^[[:space:]]*-[[:space:]]+/, ""); print; next }
  in_list && /^[^[:space:]-]/ { exit }
' "$state_index" 2>/dev/null | head -5 | paste -sd ', ' -)"
[ -n "$read_list" ] || read_list="current.yaml only"

if [ "$event" = "PreCompact" ]; then
  msg="<system-reminder>
RESUMABILITY - docs/analysis state exists at ${state_index}. Before compaction,
flush current state now: update current.yaml, decisions.yaml, artifact_registry.yaml,
active phase/run/handoff records, and index.yaml read_for_current_task. The next
session resumes from the index, not from the compacted chat summary.
</system-reminder>"
  emit "PreCompact" "$(escape_for_json "$msg")"
fi

decision_line=""
[ -n "$latest_decision" ] && decision_line="
- Latest decision hint: $(sanitize_excerpt "$latest_decision")"

msg="<system-reminder>
RESUMABILITY - docs/analysis/index.yaml exists at ${state_index}. This is a
resumed or freshly-started analysis session. Do not restart, re-frame, re-run
completed phases, or re-derive locked decisions.
Snapshot:
- Updated: $(sanitize_excerpt "$updated")
- Active phase: $(sanitize_excerpt "$active_phase")
- Status: $(sanitize_excerpt "$status")
- Next action: $(sanitize_excerpt "$next_action")
- Read next: $(sanitize_excerpt "$read_list")${decision_line}
Open docs/analysis/index.yaml first, then only the records named for the current
task. Keep YAML state current as you work.
</system-reminder>"

emit "SessionStart" "$(escape_for_json "$msg")"
