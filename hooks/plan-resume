#!/usr/bin/env bash
# SessionStart + PreCompact hook for causal-powers resumability.
#
# Durable state lives in docs/analysis/index.yaml (schema v2 — index.yaml
# carries updated/active_phase/next_action/blockers directly; there is no
# separate current.yaml) plus the small YAML records it names. The hook
# injects only a compact snapshot so fresh/compacted sessions resume instead
# of restarting.
#
# docs/analysis/index.yaml is keyed FIRST and always wins if present. A
# legacy root analysis-plan.md (v1) or a leftover docs/analysis/current.yaml
# (v1 folder layout) is supported ONLY as a migration signal — this hook
# never resumes a session from either; it only nudges the model to migrate
# them into docs/analysis/ v2 via analysis-state-management.

set -uo pipefail

case ",${CAUSAL_POWERS_DISABLED_HOOKS:-}," in *",plan-resume,"*) exit 0 ;; esac

payload="$(cat 2>/dev/null || true)"

event="$(printf '%s' "$payload" \
  | grep -oE '"hook_event_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
  | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')"
event="${event:-SessionStart}"

state_index=""
legacy_signal=""
for dir in "${PWD:-.}" "${CLAUDE_PROJECT_DIR:-}"; do
  [ -n "$dir" ] || continue
  if [ -f "${dir}/docs/analysis/index.yaml" ]; then
    state_index="${dir}/docs/analysis/index.yaml"
    break
  fi
  if [ -z "$legacy_signal" ] && [ -f "${dir}/analysis-plan.md" ]; then
    legacy_signal="${dir}/analysis-plan.md"
  fi
  if [ -z "$legacy_signal" ] && [ -f "${dir}/docs/analysis-plan.md" ]; then
    legacy_signal="${dir}/docs/analysis-plan.md"
  fi
  if [ -z "$legacy_signal" ] && [ -f "${dir}/docs/analysis/current.yaml" ]; then
    legacy_signal="${dir}/docs/analysis/current.yaml"
  fi
done

# docs/analysis/index.yaml always wins if present — never fall through to the
# legacy-migration branch once v2 state exists, even if a v1 file also lingers
# on disk (that lingering file is its own red flag, but not this hook's job).
[ -n "$state_index" ] || [ -n "$legacy_signal" ] || exit 0

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

sanitize_excerpt() {
  printf '%s' "$1" \
    | sed -e 's;</system-reminder>;;g' -e 's;<system-reminder>;;g' \
    | head -c 260
}

emit() {
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
    printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "%s",\n    "additionalContext": "%s"\n  }\n}\n' "$1" "$2"
  else
    printf '{\n  "additionalContext": "%s"\n}\n' "$2"
  fi
  exit 0
}

if [ -z "$state_index" ]; then
  if [ "$event" = "PreCompact" ]; then
    msg="<system-reminder>
RESUMABILITY - a legacy (v1) plan file exists at ${legacy_signal} and no
docs/analysis/index.yaml was found. This is a MIGRATE suggestion only — do
not resume from the legacy file. Before compaction, invoke
analysis-state-management and migrate it into docs/analysis/ v2 by extraction
(index.yaml + phases/<id>.yaml with plausibility_threats and topology.nodes),
then archive the legacy file under docs/analysis/scratch/ or delete it.
</system-reminder>"
  else
    msg="<system-reminder>
RESUMABILITY - a legacy (v1) plan file exists at ${legacy_signal} and no
docs/analysis/index.yaml was found. This is a MIGRATE suggestion only — do
not resume from the legacy file. Read only the section needed to recover
current goal/phase/next-action, then invoke analysis-state-management and
create docs/analysis/index.yaml (schema v2) so future sessions read the index
instead of rereading the legacy file.
</system-reminder>"
  fi
  emit "$event" "$(escape_for_json "$msg")"
fi

base_dir="$(dirname "$state_index")"

yaml_value() {
  # yaml_value <file> <key> - shallow key only, no dependency on yq/jq.
  [ -r "$1" ] || return 0
  grep -m1 -E "^[[:space:]]*$2:[[:space:]]*" "$1" \
    | sed -E "s/^[[:space:]]*$2:[[:space:]]*//" \
    | sed -E 's/^["'\'']|["'\'']$//g'
}

# Schema v2: index.yaml carries updated/active_phase/next_action directly —
# no current.yaml indirection.
updated="$(yaml_value "$state_index" updated)"
active_phase="$(yaml_value "$state_index" active_phase)"
next_action="$(yaml_value "$state_index" next_action)"

# Status lives on the phase record only (one source of truth), not the index.
phase_file=""
[ -n "$active_phase" ] && [ -f "${base_dir}/phases/${active_phase}.yaml" ] \
  && phase_file="${base_dir}/phases/${active_phase}.yaml"
status="$(yaml_value "$phase_file" status)"

[ -n "$active_phase" ] || active_phase="unknown"
[ -n "$status" ] || status="unknown"
[ -n "$next_action" ] || next_action="read docs/analysis/index.yaml, then continue"

decisions_file="${base_dir}/decisions.yaml"
latest_decision=""
if [ -r "$decisions_file" ]; then
  latest_decision="$(grep -E '^[[:space:]]*(decision|id):[[:space:]]*' "$decisions_file" 2>/dev/null | tail -2 | tr '\n' '; ' | sed 's/[[:space:]]*$//')"
fi

read_list="$(awk '
  /^[[:space:]]*read_for_current_task:[[:space:]]*$/ { in_list=1; next }
  in_list && /^[[:space:]]*-[[:space:]]+/ { sub(/^[[:space:]]*-[[:space:]]+/, ""); print; next }
  in_list && /^[^[:space:]-]/ { exit }
' "$state_index" 2>/dev/null | head -5 | paste -sd ', ' -)"
[ -n "$read_list" ] || read_list="index.yaml only"

if [ "$event" = "PreCompact" ]; then
  msg="<system-reminder>
RESUMABILITY - docs/analysis state exists at ${state_index}. Before compaction,
flush current state now: update index.yaml (updated/active_phase/next_action/
blockers/read_for_current_task), the active phase YAML, decisions.yaml,
artifact_registry.yaml, and any run/handoff records. The next session resumes
from the index, not from the compacted chat summary.
</system-reminder>"
  emit "PreCompact" "$(escape_for_json "$msg")"
fi

decision_line=""
[ -n "$latest_decision" ] && decision_line="
- Latest decision hint: $(sanitize_excerpt "$latest_decision")"

msg="<system-reminder>
RESUMABILITY - docs/analysis/index.yaml exists at ${state_index}. This is a
resumed or freshly-started analysis session. Do not restart, re-frame, re-run
completed phases, or re-derive locked decisions.
Snapshot:
- Updated: $(sanitize_excerpt "$updated")
- Active phase: $(sanitize_excerpt "$active_phase")
- Status: $(sanitize_excerpt "$status")
- Next action: $(sanitize_excerpt "$next_action")
- Read next: $(sanitize_excerpt "$read_list")${decision_line}
Open docs/analysis/index.yaml first, then only the records named for the current
task. Keep YAML state current as you work.
</system-reminder>"

emit "SessionStart" "$(escape_for_json "$msg")"
