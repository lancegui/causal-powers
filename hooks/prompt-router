#!/usr/bin/env bash
# UserPromptSubmit hook for the causal-powers plugin.
#
# WHY THIS EXISTS: the SessionStart block (hooks/session-start) injects the
# discipline ONCE, at session open, as low-priority background context. By a few
# turns in it has scrolled off and gone "wallpaper" — so when a prompt actually
# contains a trigger ("this number looks wrong", "merge these", "did it work"),
# nothing re-surfaces the matching leaf skill at that moment, and the model
# free-hands the discipline instead of invoking the skill.
#
# This hook fixes that failure mode: it runs on EVERY prompt, scans for trigger
# phrases, and injects a short, per-turn nudge that NAMES the specific skill to
# invoke. It is a soft nudge — it never blocks the prompt and adds no latency.
#
# Conventions mirror hooks/session-start: no jq dependency, always exit 0, emit
# hookSpecificOutput on Claude Code and top-level additionalContext elsewhere.

set -uo pipefail
# Kill-switch: CAUSAL_POWERS_DISABLED_HOOKS is a comma-separated list of hook
# names to disable at runtime (e.g. "prompt-router,skill-chain") — the escape
# hatch when a hook misbehaves, without uninstalling the plugin.
case ",${CAUSAL_POWERS_DISABLED_HOOKS:-}," in *",prompt-router,"*) exit 0 ;; esac


# Read the UserPromptSubmit payload and match ONLY the .prompt field. Matching
# the raw blob false-fired in production: cwd / transcript_path carry analysis-y
# path fragments (drop-shipping-app, merge-session.jsonl) that nudged on every
# prompt in such projects. Extraction is sed-only to stay dependency-free; the
# JSON-escaped text (\n as two chars) is fine for keyword matching — don't
# unescape.
payload="$(cat 2>/dev/null || true)"
prompt="$(printf '%s' "$payload" \
  | sed -nE 's/.*"prompt"[[:space:]]*:[[:space:]]*"(([^"\\]|\\.)*)".*/\1/p' | head -1)"

# Harness-injected prompt shapes are not user asks — task notifications (agent
# results: 42% of production false fires), IDE events, command/system wrappers,
# and empty prompts. Skip them before any keyword matching.
[ -z "$prompt" ] && exit 0
printf '%s' "$prompt" | grep -Eq '^([[:space:]]|\\n|\\r|\\t)*<(task-notification|ide_[a-z_]+|system-reminder|local-command|command-[a-z-]+)' && exit 0

low="$(printf '%s' "$prompt" | tr '[:upper:]' '[:lower:]')"

# Suppression guard. This hook is a HIGH-PRECISION backstop for blatant literal
# triggers, not a semantic classifier (regex tops out ~22% recall on the eval
# corpus; the model's description-based matching is the real mechanism). So when
# a prompt is plainly writing / formatting / teaching / code-syntax help that
# merely NAMES a method (DiD, IV, RDD, BLP, "join"), it is not an analysis-
# decision moment — the discipline skill should not fire, and neither should we.
# These are the should_trigger=false cases in evals/trigger and were the main
# false-fires. Suppress them outright; recall is intentionally traded for
# precision here.
if printf '%s' "$low" | grep -Eq "tighten|rephrase|reword|\bpolish\b|proofread|rewrite (the|my)|referee response|reviewer response|make (a )?slide|slide (that|to)|format (this|the|my)|latex table|significance stars|syntax for|what'?s the .*(argument|function)|difference between (an? )?(inner|left|right|outer|full)|computationally singular|explain .*(to (non-?technical|execs|a layperson)|the difference)|(intro|introduction|abstract|empirics? section) of (my|the) paper|section of (my|the) paper" \
   && ! printf '%s' "$low" | grep -Eq "\btable 1\b|summary stat(s|istic)|distribution of|what'?s the trend|the trend (in|of)|choropleth|stylized fact|describe (the|this|my|our) (data|dataset|sample|panel)|re-?run (the|it|with)|re-?estimate|corrected sample|new (effect|estimate|coefficient)|robustness (check|suite|spec)|estimate the|run the (did|regression|spec|model)"; then
  # Suppress writing/formatting/teaching prompts that merely NAME a method —
  # UNLESS the prompt also carries a concrete descriptive-DATA deliverable
  # (a Table 1, summary stats, a distribution, a trend). "Make a Table 1 for
  # the descriptive section of my paper" is a data task, not a writing task.
  exit 0
fi

# Ops/software suppressor: git, CI, docker, web-perf, and module-refactor
# prompts use merge/drop/score/regression in their SOFTWARE senses — all
# observed production false fires. Suppress unless the prompt also carries a
# data-object cue (dataset, csv, panel, join-on, cardinality, …).
if printf '%s' "$low" | grep -Eq "merge conflict|merge (it|this|that|the branch) (back )?(in)?to (main|master)|\bgit\b|\brebase\b|cherry.?pick|pull request|push to (github|origin|main|master)|docker|\bci\b (pipeline|run|job)|(unit|integration|regression) tests?|lighthouse|api (handler|endpoint|route)|separate module|refactor (the|this) (module|class|function|component)" \
   && ! printf '%s' "$low" | grep -Eq "data ?set|data ?frame|\bcsv\b|parquet|\bpanel\b|\bsurvey\b|claims data|join .{0,24}\bon\b|cardinality|rows (multiply|fan)|summary stat|regression (spec|coefficient|estimate|table|results)"; then
  exit 0
fi

# Collect matched skills (one line each). Each family is high-precision so normal
# conversation does not trip it; matching is intentionally biased toward the
# moments where the discipline is most often skipped.
matches=""
m() {  # m <regex> <nudge-line>
  if printf '%s' "$low" | grep -Eq "$1"; then
    matches="${matches}- ${2}"$'\n'
  fi
}

m "doesn'?t match|don'?t match|didn'?t match|do not match|too high|too low|off by|can'?t be right|cannot be right|that can'?t be|doesn'?t converge|wouldn'?t converge|didn'?t converge|not converg|unexpected (value|number|result|total|count|mean|sign|magnitude|jump|spike)|suspicious|totals? (are|is) off|this number|looks wrong|wrong sign|surprising|why is (this|it) so" \
  "causal-powers:wrong-number-debugging — a result looks wrong; bisect the pipeline to the bad step, do NOT guess-and-patch."

m "\bmerge\b|\bjoin\b|\bgroup by\b|\bgroupby\b|aggregate|\breshape\b|combine (these|the)|cardinality|row counts?" \
  "causal-powers:data-contracts — assert join cardinality + row counts and reconcile totals BEFORE trusting the merged result."

m "effect of|did it work|impact of|\bregress(ing)? .{0,28}\bon\b|regression (of|on|coefficient|model|spec|output|estimate|table|results?)|run (a |the )?regression|\bcaused\b|because we (did|ran)|did (the |this )?(policy|program|intervention|treatment|law|reform|mandate|expansion|rollout|ban|subsidy|tax)|(policy|program|intervention|treatment|law|reform|mandate|expansion) (raise|lower|increase|reduce|cause|affect|change|move|boost|cut)|treatment (effect|increased|raised)|difference.?in.?difference|event study|\biv\b|instrumental variable|\binstrument for\b|(weak|valid|strong) instrument|regression discontinuity|\brdd\b|synthetic control|parallel trends" \
  "causal-powers:causal-identification — name the design + test its assumptions before reading a coefficient as an effect."

m "drop (them|those)\b|drop (the |these |those |all |any )?((two|three|four|[0-9]+) )?(weakest |strongest |extreme )?(outlier|row|observation|obs\b|missing|na\b|nan|duplicate|extreme|top|bottom|instrument|control|covariate|variable|firm|unit|group|state|count(y|ies)|year)|drop .{0,24}from the (sample|panel|dataset|data)|winsoriz|trim the|remove (the )?outlier|exclude (the|these|those)|\bfilter out\b|should i drop|change the (spec|sample|definition)|redefine|re-?run with" \
  "causal-powers:analysis-checkpoints — this changes sample/spec/a seen number; STOP and surface options, don't decide it silently."

m "report this|final (number|result|estimate|figure|table|answer)|final .{0,10}check|the answer is|put(ting)? (it|this|these|that|the (number|result|estimate|figure|table)) in (the |a )?([a-z]+ )?(deck|slide|paper|report|memo)|send this to|in the (deck|slide|paper|table)|looks right|i'?m done|ready to ship" \
  "causal-powers:result-verification — reconcile to source + reproduce from a clean seed before this number leaves the room."

m "\bblp\b|demand estimation|counterfactual|structural (model|estimat)|merger sim|discrete choice|\bgmm\b|equilibrium|recover( the)? parameters" \
  "causal-powers:structural-estimation — write/confirm the model card (per-parameter identification + recovery test) before estimating."

m "\bpredict(ion|ive)?\b|forecast|classif(y|ier)|risk[ -]scor|\banomal\w*|flag (the |which ).{0,24}(outlier|anomal|suspicious|risk|fraud|divert|churn)|rank (these|by )|churn|which .*(likely|at risk)|train.*(model|classifier)|train[/ ]test split|scor(e|ing) (each|the|these|every|all)" \
  "causal-powers:predictive-modeling — write/confirm the Prediction Spec (label+regime, prediction-time, deployment-matched split, leakage audit, metric-to-decision) before fitting; prove the eval is honest; importance is not causation."

m "review (this|my) (analysis|notebook|script|model)|check my (notebook|analysis)|before i (send|ship|publish)|is this analysis|sanity.?check|does this look right" \
  "causal-powers:analysis-review — hunt the silent-failure classes (unchecked joins, leakage, fished specs, undefined metrics)."

m "analyze this|what'?s the trend|how many (users|people|rows|records)|look into (this|the) (data|dataset)|build (me )?(a )?(metric|dashboard)|measure the|(write|draft|put together|spec) (me )?(an? |the |my )?(analysis|data) plan|plan (for|out) (the|this|my) (analysis|estimation|metric|dataset)|what data (do (we|i) need (for|to) (the |this |my )?([a-z]+ )?(analys|metric|estimat|model|number|regression|cohort)|does (this|that) (come from|live))|where (does|do) (the|this|that) ([a-z]+ )?(data|number|metric) (come from|live)|how (should|do|would) (we|i) (approach|structure|spec) (this|the|my) (analysis|estimation|metric)|(spec|approach) (out |for )?(the|this|my) (analysis|estimation)|before (we|i) (build|touch) (the )?(dataset|pipeline|model|analysis)|leaflet map|choropleth|interactive map|map (of|showing) (the |my |these |our |all )?(facilit|clinic|store|site|plant|hospital|provider|count(y|ies)|tract|zip|district|jurisdiction|treatment|region|location)|(plot|map|visuali[sz]e|chart|graph) (the |my |these |our |all )?(data|dataset|facilit|clinic|observ|points|panel|sample|coordinat|distribution|series)|(make|build|create|draw|generate) (me )?(a |an )?(figure|chart|map|dashboard|plot|graph|visuali[sz]ation|heat ?map|histogram|scatter|time series|summary table) (of|for|showing|that shows|with|from)" \
  "causal-powers:question-framing — pin the estimand/metric (for a viz: the unit each mark represents + what it encodes + the data sources & joins), population, AND, for general/exploratory work, the DATA sources + APPROACH/spec + deliverable (the everyday analysis plan) — written to a file and signed off before code. A map/figure/dashboard built from data enters here too (a fanned-out ownership join double-plots a facility; a point outside every polygon drops silently → hand the joins to data-contracts). If the cut is causal it forks to pre-analysis-plan."

m "what'?s the (trend|distribution|growth)|the trend (in|of|over)|\btrends? (in|of|over|line)|\btrend(ed|ing)? (over|across|by|up|down)|\bover time\b|over the (last|past) (decade|century|[0-9]+ ?years?|year|month|period|few)|(how (has|have|did|do)|has|have) .{0,45}(chang|grown|grow|evolv|trend|gone up|gone down|risen|increas|declin|widen) .{0,18}(over|across|by year|since|from|the (last|past))|gone up\b|\bgrowth\b|grew (from|by|over)|exploded|skyrocket|surged|gap .{0,25}(widen|narrow|grow|shrink)|summary stat(s|istic)|descriptive stat|\btable 1\b|describe (the|this|my|our|what'?s) .{0,25}(data|dataset|sample|panel|population|going on)|headline numbers|stylized fact|motivating (fact|trend|chart|figure)|distribution of|how (skewed|distributed)|share of .{0,45}(over|across|by year|by month|trend|shift|generic|brand)|concentrated in|where (are|is) .{0,30}concentrated|choropleth|leaflet map|interactive map|\bmap (of|showing)|map .{0,30}(rate|per[- ]capita|by (county|state|tract|zip|region|district))|jumped .{0,15}(%|from|to|by|[0-9])|(confirm|verify) (that'?s|it'?s|this is|the) .{0,20}(real|right|gone up|trend|increase|growth)" \
  "causal-powers:descriptive-evidence — the deliverable is a DESCRIPTION (trend / summary-stats table / distribution / stylized fact / map), not an effect. Fix the comparability choices (denominator, real-vs-nominal + base year, per-capita, weighting) before plotting; run the composition check (within-vs-between — a mix shift, not a within-group change; a raw-count choropleth just maps population); show the distribution not just the mean; keep the verb descriptive — a stylized fact MOTIVATES a causal question, it doesn't answer it. Co-fires with question-framing (frame it) — descriptive-evidence makes the description honest."

m "run all (of )?the specs|do the robustness (check|spec|suite)|now (do|run) the analysis|(execute|run) the (plan|analysis|pap|brief|pre-?analysis plan)|(brief|pap|pre-?analysis plan) (is |was )?(approved|signed off)|signed off on the (pap|plan|brief)|estimate the primary (spec|specification|did spec|regression)|fan (these|this|it|them|the [a-z ]{0,30})out (to )?(parallel )?subagents|dispatch .{0,30}(to )?(parallel )?subagents|plan looks good.{0,30}(run|go|execute)" \
  "causal-powers:executing-analysis-plans — run the approved plan along its dependent spine and declared independent leaves. In OpenCode with causal-conductor, the approved docs/analysis topology is the execution-mode consent: do not re-ask inline-vs-subagent for nodes already approved; dispatch each approved independent leaf to the appropriate subagent and keep the spine in order. Ask the user inline-vs-parallel only when no approved topology exists. Keep it bounded: pick the ~3 checks that earn their place — choosing which is an analysis-checkpoints decision, not a silent buffet."

m "pre-?register|pre-?registration|register (this|the|my) (analysis|study|experiment)|pre-?commit (to )?(the |my )?(hypothes|spec|estimand|analys|primary|sample|robustness|exclusion)|lock (the |in )?(hypothes|primary spec|sample|exclusion|robustness)|before (we|i) (unblind|look at the (outcome|result|metric|conversion|endline|number)|see the outcome|peek)|confirmatory (readout|analysis|study)|pre-?analysis plan|\bpap\b|(evaluate|test) whether (the |this |our )?(experiment|a/?b test|ab test|policy|mandate|program|rollout|pilot|trial|intervention|campaign|treatment|pricing|price|discount|tutoring|feature|redesign|revamp)|test the hypothes|did (the|our) (experiment|a/?b test|pricing experiment|pilot|rollout|trial) (move|work|increas|reduc|rais|lower)" \
  "causal-powers:pre-analysis-plan — confirmatory / high-stakes work (experiment readout, policy eval, a result you have a stake in): write the PAP (hypotheses, estimand, primary spec, sample/exclusions, robustness suite) and LOCK it to a file BEFORE seeing outcomes, so the analysis is confirmatory not a spec search. Genuinely exploratory work doesn't need a PAP — label it exploratory and move on."

m "docs/analysis|analysis[- ]state|state folder|index\\.yaml|artifact registry|decisions\\.yaml|current\\.yaml|handoff(s)?|resume (the|this|my) (analysis|study|project)|compact(ion)? state|phase state|durable (analysis )?(state|memory)|analysis memory" \
  "causal-powers:analysis-state-management — maintain docs/analysis/index.yaml plus compact current/decision/artifact/phase/run/handoff YAML records; read the index first, not one giant plan."

m "clean (up |and |the |this |these |my )?(the |this |these |my )?(raw |messy |source |survey |claims |panel |transaction )?(data ?set|dataframe|csv|parquet|survey|records?)|(prep|prepare|assemble|build|construct|put together|wrangle) (the |this |these |my |an? )?((analysis|final|clean|master|modeling|study|regression|estimation) )?(data ?set|dataframe)|(prep|prepare|assemble|build|construct|put together|wrangle) (the |this |these |my |an? )?(analysis|final|clean|master|modeling|study|estimation|monthly|quarterly) (panel|sample|cohort|extracts?)|(de-?dup\w*|recod\w*|standardi[sz]\w*|normali[sz]\w*|harmoni[sz]\w*|reconcil\w*|imput\w*) (the |these |this |my |all )?(raw |messy |source |customer |survey |claims |industry |missing |duplicate )?(data|dataset|rows|records?|values|columns|variables|categor\w*|response|extract|panel|survey|ids?|keys?|fields?|codes?)|ingest (the |this |my |raw |new )?(survey |claims |panel |transaction |customer |source )?(data ?set|data|csv|parquet|extracts?|records?|panel|survey)|(messy|raw|dirty) (data ?set|data|extract|survey|panel|records?|csv|exports?)|cleaning (phase|step|pipeline|plan)|data (cleaning|preparation|prep|wrangling)|get(ting)? (the |this |my )?(data|dataset) (ready|clean|analysis-ready)|analysis-ready (data|dataset)" \
  "causal-powers:data-preparation — own the cleaning PHASE: decompose ingest → clean → join → dedup → recode → reconcile into docs/analysis phase YAML plus decisions.yaml, and CALL data-contracts to validate each step (you're the doer, it's the checker). Any drop/dedup/winsorize/recode that changes the sample or moves a number the user has seen forks to analysis-checkpoints."

m "clean up (the|this|my) (repo|repository|project|directory|folder)|organi[sz]e (the|this|my) (repo|project|folder|directory)|folder structure|reorgani[sz]e the|standardi[sz]e (the )?(naming|file names)|make (this|it|the (repo|project)) reproducible|replication package|before (i|we) push|commit a checkpoint|what'?s (a )?deliverable|sort out what'?s a deliverable" \
  "causal-powers:project-organization — place & name by the paper-centric convention (deliverables vs scratch, data/{raw,intermediate,output}); tidy scratch and commit checkpoints at phase boundaries; never touch raw data."

m "refactor (this|the|my) (script|notebook|pipeline|analysis)|make (this|the) (script|notebook|analysis|code) (readable|legible|cleaner)|annotate (this|the|my) (script|notebook|analysis)|over-?engineer|premature abstraction|simplest analysis|simplify (this|the) (script|notebook|pipeline)" \
  "causal-powers:analysis-craft — minimal, surgical analysis code: no speculative pipeline, no unrequested config; touch only what the task needs and keep the WHY of sample restrictions legible."

m "make (me )?(a |an )?(figure|chart|plot|graph|exhibit|coefficient plot|event.?study plot|did.?plot|trend (figure|chart|plot)|bar (chart|graph|plot)|scatter (plot|figure)|distribution (plot|figure)|density (plot|figure)|histogram)|(plot|draw|make|create|generate|build) (a |an |the |me )?.{0,15}(figure|chart|plot|graph|bar (chart|graph|plot)|histogram|scatter|density|distribution|coefficient plot|event.?study|did.?plot)|plot (the|this|these|my) (coefficient|estimate|result|effect|trend|data|event.?study)|visuali[sz]e (the|this|these|my).{0,20}(result|coefficient|estimate|effect|trend|data|treatment)|figure for (the|my|a) (paper|deck|slide|presentation)|presentation (figure|chart|plot|graph)|coefficient plot|event.?study (figure|plot|chart)|did (figure|plot|chart)|matplotlib (figure|plot|chart)|seaborn (figure|plot)|ggplot (figure|chart|plot)|makie (figure|plot)|plots\.jl|savefig|ggsave|export figure|save.{0,15}(figure|plot|chart|graph).{0,15}(pdf|png|svg|jpg|eps|tiff)" \
  "causal-powers:figure-craft — presentation-ready figures in ANY language (R/Python/Julia): clean theme + colorblind-safe Paul-Tol palette, 16.5pt fonts, no y-label (title carries it), concise axis labels, right geom (dots+error bars for estimates, lines for series, stacks for composition), dashed treatment line for DiD, B&W-safe (shape/linetype redundancy not color alone), at most 1-2 enhancing annotations inside the canvas (absolute counts on pct bars, pretreatment level label), metadata in LaTeX notes, saved to results/figures/ at 5×3 in. MANDATORY visual self-check: render + open + verify no clipping/overlap + grayscale legible. Fires AFTER data is validated — route to result-verification first if numbers aren't checked."

# No trigger: inject nothing, never disturb the prompt.
if [ -z "$matches" ]; then
  exit 0
fi

context="<system-reminder>
Causal Powers trigger detected in this prompt. Per the discipline, invoke the matching skill via the Skill tool BEFORE responding — do not free-hand it from memory; the skill files carry checklists you are otherwise working without. If, after invoking, a skill turns out not to fit, you may stand down.

Matched:
${matches}</system-reminder>"

# Escape for safe JSON embedding (single-pass bash parameter substitution).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
context_escaped=$(escape_for_json "$context")

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$context_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context_escaped"
fi

exit 0
