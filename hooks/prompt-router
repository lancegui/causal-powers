#!/usr/bin/env bash
# UserPromptSubmit hook for the causal-powers plugin.
#
# WHY THIS EXISTS: the SessionStart block (hooks/session-start) injects the
# discipline ONCE, at session open, as low-priority background context. By a few
# turns in it has scrolled off and gone "wallpaper" — so when a prompt actually
# contains a trigger ("this number looks wrong", "merge these", "did it work"),
# nothing re-surfaces the matching leaf skill at that moment, and the model
# free-hands the discipline instead of invoking the skill.
#
# This hook fixes that failure mode: it runs on EVERY prompt, scans for trigger
# phrases, and injects a short, per-turn nudge that NAMES the specific skill to
# invoke. It is a soft nudge — it never blocks the prompt and adds no latency.
#
# Conventions mirror hooks/session-start: no jq dependency, always exit 0, emit
# hookSpecificOutput on Claude Code and top-level additionalContext elsewhere.

set -uo pipefail

# Read the whole UserPromptSubmit payload. The prompt text lives in .prompt; we
# grep the raw blob (lowercased) to stay dependency-free. The payload is just
# session_id / prompt / cwd, so false matches on other fields are not a concern.
payload="$(cat 2>/dev/null || true)"
low="$(printf '%s' "$payload" | tr '[:upper:]' '[:lower:]')"

# Suppression guard. This hook is a HIGH-PRECISION backstop for blatant literal
# triggers, not a semantic classifier (regex tops out ~22% recall on the eval
# corpus; the model's description-based matching is the real mechanism). So when
# a prompt is plainly writing / formatting / teaching / code-syntax help that
# merely NAMES a method (DiD, IV, RDD, BLP, "join"), it is not an analysis-
# decision moment — the discipline skill should not fire, and neither should we.
# These are the should_trigger=false cases in evals/trigger and were the main
# false-fires. Suppress them outright; recall is intentionally traded for
# precision here.
if printf '%s' "$low" | grep -Eq "tighten|rephrase|reword|\bpolish\b|proofread|rewrite (the|my)|referee response|reviewer response|make (a )?slide|slide (that|to)|format (this|the|my)|latex table|significance stars|syntax for|what'?s the .*(argument|function)|difference between (an? )?(inner|left|right|outer|full)|computationally singular|explain .*(to (non-?technical|execs|a layperson)|the difference)|(intro|introduction|abstract|empirics? section) of (my|the) paper|section of (my|the) paper"; then
  exit 0
fi

# Collect matched skills (one line each). Each family is high-precision so normal
# conversation does not trip it; matching is intentionally biased toward the
# moments where the discipline is most often skipped.
matches=""
m() {  # m <regex> <nudge-line>
  if printf '%s' "$low" | grep -Eq "$1"; then
    matches="${matches}- ${2}"$'\n'
  fi
}

m "doesn'?t match|don'?t match|didn'?t match|do not match|too high|too low|off by|can'?t be right|cannot be right|that can'?t be|doesn'?t converge|wouldn'?t converge|didn'?t converge|not converg|unexpected|suspicious|totals? (are|is) off|this number|looks wrong|wrong sign|surprising|why is (this|it) so" \
  "causal-powers:wrong-number-debugging — a result looks wrong; bisect the pipeline to the bad step, do NOT guess-and-patch."

m "\bmerge\b|\bjoin\b|\bgroup by\b|\bgroupby\b|aggregate|\breshape\b|combine (these|the)|cardinality|row counts?" \
  "causal-powers:data-contracts — assert join cardinality + row counts and reconcile totals BEFORE trusting the merged result."

m "effect of|did it work|impact of|\bregress|\bcaused\b|because we (did|ran)|did (the |this )?(policy|program|intervention|treatment|law|reform|mandate|expansion|rollout|ban|subsidy|tax)|(policy|program|intervention|treatment|law|reform|mandate|expansion) (raise|lower|increase|reduce|cause|affect|change|move|boost|cut)|treatment (effect|increased|raised)|difference.?in.?difference|event study|\biv\b|instrument|regression discontinuity|\brdd\b|synthetic control|parallel trends" \
  "causal-powers:causal-identification — name the design + test its assumptions before reading a coefficient as an effect."

m "\bdrop\b|winsoriz|trim the|remove (the )?outlier|exclude (the|these|those)|\bfilter out\b|should i drop|change the (spec|sample|definition)|redefine|rebuild|re-?run with" \
  "causal-powers:analysis-checkpoints — this changes sample/spec/a seen number; STOP and surface options, don't decide it silently."

m "report this|\bfinal\b|the answer is|put this in|send this to|in the (deck|slide|paper|table)|sanity.?check|does this look right|looks right|i'?m done|ready to ship" \
  "causal-powers:result-verification — reconcile to source + reproduce from a clean seed before this number leaves the room."

m "\bblp\b|demand estimation|counterfactual|structural (model|estimat)|merger sim|discrete choice|\bgmm\b|equilibrium|recover( the)? parameters" \
  "causal-powers:structural-estimation — write/confirm the model card (per-parameter identification + recovery test) before estimating."

m "review (this|my) (analysis|notebook|script|model)|check my (notebook|analysis)|before i (send|ship|publish)|is this analysis" \
  "causal-powers:analysis-review — hunt the silent-failure classes (unchecked joins, leakage, fished specs, undefined metrics)."

m "analyze this|what'?s the trend|how many (users|people|rows|records)|look into (this|the) (data|dataset)|build (me )?(a )?(metric|dashboard)|measure the|(write|draft|put together|spec) (me )?(an? |the |my )?(analysis|data) plan|plan (for|out) (the|this|my) (analysis|estimation|metric|dataset)|what data (do (we|i) need (for|to) (the |this |my )?([a-z]+ )?(analys|metric|estimat|model|number|regression|cohort)|does (this|that) (come from|live))|where (does|do) (the|this|that) ([a-z]+ )?(data|number|metric) (come from|live)|how (should|do|would) (we|i) (approach|structure|spec) (this|the|my) (analysis|estimation|metric)|(spec|approach) (out |for )?(the|this|my) (analysis|estimation)|before (we|i) (build|touch) (the )?(dataset|pipeline|model|analysis)" \
  "causal-powers:question-framing — pin the estimand/metric, population, and unit AND, for general/exploratory work, the DATA sources + APPROACH/spec + deliverable (the everyday analysis plan), written to a file and signed off before code. If the cut is causal it forks to pre-analysis-plan."

m "run all (of )?the specs|do the robustness (check|spec|suite)|now (do|run) the analysis|(execute|run) the (plan|analysis|pap|brief|pre-?analysis plan)|(brief|pap|pre-?analysis plan) (is |was )?(approved|signed off)|signed off on the (pap|plan|brief)|estimate the primary (spec|specification|did spec|regression)|fan (these|this|it|them|the [a-z ]{0,30})out (to )?(parallel )?subagents|dispatch .{0,30}(to )?(parallel )?subagents|plan looks good.{0,30}(run|go|execute)" \
  "causal-powers:executing-analysis-plans — run the approved plan along its dependent (inline) spine; for the independent fan-out, ASK the user up front whether to run it INLINE or via parallel SUBAGENT dispatch (robustness-runner / dispatching-parallel-agents) — present the choice, don't silently pick. And keep it bounded: pick the ~3 checks that earn their place — choosing which is an analysis-checkpoints decision, not a silent buffet."

m "pre-?register|pre-?registration|register (this|the|my) (analysis|study|experiment)|pre-?commit (to )?(the |my )?(hypothes|spec|estimand|analys|primary|sample|robustness|exclusion)|lock (the |in )?(hypothes|primary spec|sample|exclusion|robustness)|before (we|i) (unblind|look at the (outcome|result|metric|conversion|endline|number)|see the outcome|peek)|confirmatory (readout|analysis|study)|pre-?analysis plan|\bpap\b|(evaluate|test) whether (the |this |our )?(experiment|a/?b test|ab test|policy|mandate|program|rollout|pilot|trial|intervention|campaign|treatment|pricing|price|discount|tutoring|feature|redesign|revamp)|test the hypothes|did (the|our) (experiment|a/?b test|pricing experiment|pilot|rollout|trial) (move|work|increas|reduc|rais|lower)" \
  "causal-powers:pre-analysis-plan — confirmatory / high-stakes work (experiment readout, policy eval, a result you have a stake in): write the PAP (hypotheses, estimand, primary spec, sample/exclusions, robustness suite) and LOCK it to a file BEFORE seeing outcomes, so the analysis is confirmatory not a spec search. Genuinely exploratory work doesn't need a PAP — label it exploratory and move on."

m "clean (up |and |the |this |these |my )?(the |this |these |my )?(raw |messy |source |survey |claims |panel |transaction )?(data ?set|dataframe|csv|parquet|survey|records?)|(prep|prepare|assemble|build|construct|put together|wrangle) (the |this |these |my |an? )?((analysis|final|clean|master|modeling|study|regression|estimation) )?(data ?set|dataframe)|(prep|prepare|assemble|build|construct|put together|wrangle) (the |this |these |my |an? )?(analysis|final|clean|master|modeling|study|estimation|monthly|quarterly) (panel|sample|cohort|extracts?)|(de-?dup\w*|recod\w*|standardi[sz]\w*|normali[sz]\w*|harmoni[sz]\w*|reconcil\w*|imput\w*) (the |these |this |my |all )?(raw |messy |source |customer |survey |claims |industry |missing |duplicate )?(data|dataset|rows|records?|values|columns|variables|categor\w*|response|extract|panel|survey|ids?|keys?|fields?|codes?)|ingest (the |this |my |raw |new )?(survey |claims |panel |transaction |customer |source )?(data ?set|data|csv|parquet|extracts?|records?|panel|survey)|(messy|raw|dirty) (data ?set|data|extract|survey|panel|records?|csv|exports?)|cleaning (phase|step|pipeline|plan)|data (cleaning|preparation|prep|wrangling)|get(ting)? (the |this |my )?(data|dataset) (ready|clean|analysis-ready)|analysis-ready (data|dataset)" \
  "causal-powers:data-preparation — own the cleaning PHASE: decompose ingest → clean → join → dedup → recode → reconcile into a phased, checkboxed plan with a decisions log (Phase 1 of analysis-plan.md), and CALL data-contracts to validate each step (you're the doer, it's the checker). Any drop/dedup/winsorize/recode that changes the sample or moves a number the user has seen forks to analysis-checkpoints."

# No trigger: inject nothing, never disturb the prompt.
if [ -z "$matches" ]; then
  exit 0
fi

context="<system-reminder>
Causal Powers trigger detected in this prompt. Per the discipline, invoke the matching skill via the Skill tool BEFORE responding — do not free-hand it from memory; the skill files carry checklists you are otherwise working without. If, after invoking, a skill turns out not to fit, you may stand down.

Matched:
${matches}</system-reminder>"

# Escape for safe JSON embedding (single-pass bash parameter substitution).
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
context_escaped=$(escape_for_json "$context")

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "UserPromptSubmit",\n    "additionalContext": "%s"\n  }\n}\n' "$context_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context_escaped"
fi

exit 0
