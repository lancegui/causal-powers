#!/usr/bin/env bash
# PostToolUse hook for the causal-powers plugin, matched on the Skill tool.
#
# WHY THIS EXISTS: some discipline skills carry a MANDATORY next step that is an
# internal workflow transition, not something the user types a keyword for — so
# the UserPromptSubmit keyword router (hooks/prompt-router) structurally cannot
# catch it. The worst offender: after question-framing the spine REQUIRES a
# written plan and an approval gate BEFORE any estimation (using-causal-powers
# spine: "framing -> [pre-analysis-plan / model card] -> (approval gate)"). The
# skill text already says this; the failure is barreling from framing straight
# into estimation anyway. This hook re-surfaces the obligation at the exact
# moment the framing skill is invoked.
#
# It fires after EVERY Skill call but injects ONLY for the gated transitions;
# everything else is silent. Conventions mirror the other hooks: no jq, always
# exit 0, hookSpecificOutput on Claude Code / top-level additionalContext else.

set -uo pipefail
# Kill-switch: CAUSAL_POWERS_DISABLED_HOOKS is a comma-separated list of hook
# names to disable at runtime (e.g. "prompt-router,skill-chain") — the escape
# hatch when a hook misbehaves, without uninstalling the plugin.
case ",${CAUSAL_POWERS_DISABLED_HOOKS:-}," in *",skill-chain,"*) exit 0 ;; esac


payload="$(cat 2>/dev/null || true)"

# Extract the invoked skill name from tool_input.skill (jq-free). Strip an
# optional plugin prefix so "causal-powers:question-framing" and bare
# "question-framing" both match.
skill="$(printf '%s' "$payload" \
  | grep -oE '"skill"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
  | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')"
skill="${skill##*:}"

case "$skill" in
  question-framing)
    msg="Spine transition — framing is NOT the last step. Before you touch data or estimate anything, the discipline REQUIRES durable analysis state and an approval gate:
- Invoke causal-powers:analysis-state-management and write the framing brief into docs/analysis/ Phase-0 state (estimand/metric, population, unit, the decision, what would flip it).
- If the study is confirmatory (experiment readout, policy eval, anything with stakes): invoke causal-powers:pre-analysis-plan and lock it BEFORE seeing outcomes.
- If the estimand is a counterfactual OUTSIDE the data (welfare, merger price, equilibrium response): invoke causal-powers:structural-estimation and write the model card instead.
- If the GOAL is a prediction rather than an effect (predict/score/rank/flag/classify/forecast/detect-anomalies units to drive an action): invoke causal-powers:predictive-modeling and write the Prediction Spec instead — route by GOAL not algorithm (ML used to estimate a causal effect, e.g. double ML / causal forests, stays in causal-identification).
- If the deliverable is a DESCRIPTION rather than an effect/counterfactual/prediction (a trend, distribution, summary-stats table, stylized fact, or map): invoke causal-powers:descriptive-evidence — fix the comparability choices and run the composition check before plotting; a striking fact MOTIVATES the causal question, it doesn't answer it.
- If general/exploratory (neither of the above): the brief is NOT done — extend docs/analysis state with DATA sources (tables/files, grain, joins — and are they reachable?), APPROACH/spec, and the DELIVERABLE, and the sign-off must cover those, not just the metric. That brief-with-plan IS the plan executing-analysis-plans expects. (See question-framing's 'The plan: data, approach, deliverable' section — don't restate it, follow it.) HARD STOP if the cut turns causal: you may not proceed until the confirmatory determination is answered — a causal cut you'll report belongs in a pre-analysis-plan, not an everyday plan.
Then STOP and get the user's sign-off. Do NOT barrel from framing into estimation — the approval gate is the user's decision. (Trivial one-liners may be waived, but say so explicitly.)"
    ;;
  pre-analysis-plan)
    msg="The PAP is a confirmatory contract. Write it to a file and get the user's EXPLICIT approval before estimating — a PAP you drafted but never had signed off does not make the work confirmatory. After sign-off, route execution through causal-powers:executing-analysis-plans (don't hand-run the specs)."
    ;;
  structural-estimation)
    msg="Model card before machinery. Write primitives, per-parameter identification, the target counterfactual, and the estimation plan to a file and get the user's sign-off BEFORE building estimation code. A converged optimizer is not an identified model — name what identifies each parameter and plan the Monte-Carlo recovery test now, not after."
    ;;
  executing-analysis-plans)
    msg="Execution has a dependent spine (runs inline, in order) AND an independent fan-out (robustness specs, competing designs, subsample cuts, placebos, multiple outcomes; for structural work: recovery reps, starting values, per-mechanism counterfactuals). For the fan-out, ASK FIRST — present the execution-mode choice up front, do NOT silently pick: (a) INLINE — each chosen spec in turn, here, fully observable; or (b) SUBAGENT DISPATCH — one parallel subagent per spec via the shipped causal-powers:robustness-runner (superpowers dispatching-parallel-agents / subagent-driven-development for the mechanics). Recommend subagent dispatch for genuinely independent specs, but it is the user's call. Two guardrails on top: (1) the fan-out is BOUNDED — pick the ~3 checks that earn their place; 'cheap to run' is the trap, a wall of specs reads as weak identification, and choosing WHICH to run is itself an analysis-checkpoints decision, not a silent buffet. (2) End in result-verification before any result is written to a file. Whichever mode, each dispatched/run spec carries its exact recipe + the checkpoint rule."
    ;;
  causal-identification)
    msg="A regression coefficient is NOT a causal effect until the design earns it. Before reading the estimate causally, state the identification strategy and TEST its assumptions (parallel trends / first-stage strength / manipulation / balance / placebo / sensitivity — the design-specific suite is mandatory, not optional). Then route: design tested + robustness passed → invoke causal-powers:result-verification before reporting. A failed diagnostic or a needed design change → STOP and invoke causal-powers:analysis-checkpoints (the user decides, you don't redesign silently). Wrong sign/magnitude → rule out a data bug via causal-powers:wrong-number-debugging first. See this skill's 'When to Use' graph."
    ;;
  result-verification)
    msg="Verification is not the finish line — it forks. If any check FAILS (won't reconcile / won't reproduce / magnitude absurd) → STOP and invoke causal-powers:wrong-number-debugging (or analysis-checkpoints if the fix is a design change); do not footnote a failed check and ship. If all checks pass → invoke causal-powers:analysis-review to dispatch the independent reviewer for the silent-failure sweep BEFORE shipping, then causal-powers:project-organization to tidy scratch before committing. Don't end at 'the result is X'. See this skill's 'When to Use' graph."
    ;;
  data-contracts)
    msg="A clean run is not a correct number. If a reconciliation / total / join-cardinality assertion FAILS → STOP and invoke causal-powers:wrong-number-debugging to bisect to the exact bad step — don't patch and proceed. If the tempting 'fix' would drop/filter/winsorize rows, change a join's grain, or move a number the user has already seen → that's a sample/spec redesign: STOP and invoke causal-powers:analysis-checkpoints, don't smuggle it in. Otherwise freeze the validated result as a baseline and continue. See this skill's 'When to Use' graph."
    ;;
  data-preparation)
    msg="Cleaning is the analysis, not pre-analysis — plan it, don't barrel. You own the data-ingest-and-cleaning PHASE in docs/analysis/ (phase YAML + decisions.yaml): decompose ingest → clean → join → dedup → recode → reconcile into a checkboxed sub-plan with a DECISIONS LEDGER, and write to disk after every couple of actions (it survives /clear + compaction and is the audit trail). You are the DOER; CALL causal-powers:data-contracts to validate every step (assert join cardinality before each merge, reconcile totals after) — don't hand-roll validation. HARD STOP: any drop / filter / winsorize / non-trivial dedup / recode-of-a-reported-grouping — or anything that moves a number the user has seen — is a sample/spec change → invoke causal-powers:analysis-checkpoints, the user's call, don't smuggle it in as tidying. A failed reconciliation → causal-powers:wrong-number-debugging. When Phase 1 is ticked and the clean dataset reconciles → return to causal-powers:executing-analysis-plans for construction/estimation. Trivial single clean file → state the waiver, skip the plan. See this skill's 'When to Use' graph."
    ;;
  predictive-modeling)
    msg="Prediction Spec before fitting. Write it to a file (decision + cost asymmetry, label + regime, prediction-time, features + leakage audit, deployment-matched split, metric-tied-to-decision + baseline, method) and get the user's sign-off BEFORE any model code. Then PROVE the eval honest before trusting a metric: permutation-null probe run WITHIN the split structure, repeated (recipe: references/leakage-and-splits.md), deployment-mirroring holdout, calibration, beat-the-baseline. Feature importance / SHAP is NOT a causal effect. End in causal-powers:result-verification before any score/ranking ships."
    ;;
  wrong-number-debugging)
    msg="Bisect, don't guess-and-patch. Route first: code THROWS or a test fails → superpowers:systematic-debugging; code runs CLEAN but the number is wrong → this skill. When the bad step is found: a mechanical restoring fix → apply it and report (cite the written line that establishes the intended behavior); any remedy that changes design/sample/spec or moves a number the user has seen → STOP, causal-powers:analysis-checkpoints. Record the failure class in docs/LESSONS.md while it's fresh."
    ;;
  descriptive-evidence)
    msg="A description is a deliverable, and it has silent failures of its own. Before you believe a trend / gap / summary stat: fix the comparability choices (denominator, real-vs-nominal + base year, per-capita, weighting) and run the COMPOSITION CHECK on anything that moves or differs (within-vs-between / standardization; plot the subgroups; rule out selection into the sample) — a mix shift faking a within-group change is the signature artifact, and a raw-count choropleth just maps population. Then route: a fact you'll REPORT → causal-powers:result-verification (reconcile to source + reproduce) before it ships, and its joins → causal-powers:data-contracts. If a causal / structural / predictive question EMERGED from the fact → it motivates the fork, it does not license a causal verb here. Keep the verbs descriptive. See this skill's 'When to Use' graph."
    ;;
  figure-craft)
    msg="A figure is a communication artifact, not a debug plot — it will be projected or embedded and the audience gives it 3 seconds. This guide applies to EVERY figure in ANY language (R/ggplot2, Python/matplotlib, Julia/Makie). Apply the house style as PRINCIPLES (clean high-contrast theme, colorblind-safe Paul-Tol palette, 16.5pt fonts, NO y-axis label — the meaning goes in the title/subtitle), concise x-axis label, dashed vertical line at the treatment threshold (-0.5 in event-time) for DiD/event-study, zero line. In R: theme_hc() + scale_color_ptol() from ggthemes; in Python/Julia: translate the same principles (Paul-Tol hex codes: #332288 #117733 #44AA99 #88CCEE #DDCC77 #CC6677 #AA4499 #882255). Pick the geom by the message: dots + error bars for discrete estimates (NEVER connect independent estimates with a line — it invents a trajectory); lines for continuous observed series; stacked bars for composition; dodged bars for cross-sectional comparison. B&W-SAFE: every group distinction needs a redundant non-color channel (shape for points, linetype for lines, hatch for bars, or direct labels) — color alone collapses in grayscale. At most 1-2 inside-canvas ANNOTATIONS that ENHANCE understanding (absolute values on percentage bars, 'pretreatment treatment group' label for relative scale on DiD) — metadata (N, source, p-values) goes in LaTeX figure notes. Standard output: 5×3 inches, saved to results/figures/fig_<name>.pdf per project-organization. Then MANDATORY: render to file and VISUALLY EXAMINE it — no text clipped, no overlapping axis labels (reduce breaks on a busy x-axis), no legend overflow (wrap to two rows or move to bottom), legible in grayscale. This skill fires AFTER the data is validated — if the numbers haven't been verified, route to result-verification first; a polished figure of a wrong number is still wrong."
    ;;
  *)
    exit 0
    ;;
esac

context="<system-reminder>
${msg}
</system-reminder>"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
context_escaped=$(escape_for_json "$context")

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$context_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context_escaped"
fi

exit 0
