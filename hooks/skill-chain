#!/usr/bin/env bash
# PostToolUse hook for the causal-powers plugin, matched on the Skill tool.
#
# WHY THIS EXISTS: some discipline skills carry a MANDATORY next step that is an
# internal workflow transition, not something the user types a keyword for — so
# the UserPromptSubmit keyword router (hooks/prompt-router) structurally cannot
# catch it. The worst offender: after question-framing the spine REQUIRES a
# written plan and an approval gate BEFORE any estimation (using-causal-powers
# spine: "framing -> [pre-analysis-plan / model card] -> (approval gate)"). The
# skill text already says this; the failure is barreling from framing straight
# into estimation anyway. This hook re-surfaces the obligation at the exact
# moment the framing skill is invoked.
#
# It fires after EVERY Skill call but injects ONLY for the gated transitions;
# everything else is silent. Conventions mirror the other hooks: no jq, always
# exit 0, hookSpecificOutput on Claude Code / top-level additionalContext else.

set -uo pipefail
# Kill-switch: CAUSAL_POWERS_DISABLED_HOOKS is a comma-separated list of hook
# names to disable at runtime (e.g. "prompt-router,skill-chain") — the escape
# hatch when a hook misbehaves, without uninstalling the plugin.
case ",${CAUSAL_POWERS_DISABLED_HOOKS:-}," in *",skill-chain,"*) exit 0 ;; esac


payload="$(cat 2>/dev/null || true)"

# Extract the invoked skill name from tool_input.skill (jq-free). Strip an
# optional plugin prefix so "causal-powers:question-framing" and bare
# "question-framing" both match.
skill="$(printf '%s' "$payload" \
  | grep -oE '"skill"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 \
  | sed -E 's/.*:[[:space:]]*"([^"]*)"$/\1/')"
skill="${skill##*:}"

case "$skill" in
  question-framing)
    msg="Spine transition — framing is NOT the last step. Before you touch data or estimate anything, the discipline REQUIRES a written plan and an approval gate:
- Write the framing brief to a file (estimand/metric, population, unit, the decision, what would flip it).
- If the study is confirmatory (experiment readout, policy eval, anything with stakes): invoke causal-powers:pre-analysis-plan and lock it BEFORE seeing outcomes.
- If the estimand is a counterfactual OUTSIDE the data (welfare, merger price, equilibrium response): invoke causal-powers:structural-estimation and write the model card instead.
- If the GOAL is a prediction rather than an effect (predict/score/rank/flag/classify/forecast/detect-anomalies units to drive an action): invoke causal-powers:predictive-modeling and write the Prediction Spec instead — route by GOAL not algorithm (ML used to estimate a causal effect, e.g. double ML / causal forests, stays in causal-identification).
- If general/exploratory (neither of the above): the brief is NOT done — extend it in the same file with DATA sources (tables/files, grain, joins — and are they reachable?), APPROACH/spec, and the DELIVERABLE, and the sign-off must cover those, not just the metric. That brief-with-plan IS the plan executing-analysis-plans expects. (See question-framing's 'The plan: data, approach, deliverable' section — don't restate it, follow it.) HARD STOP if the cut turns causal: you may not proceed until the confirmatory determination is answered — a causal cut you'll report belongs in a pre-analysis-plan, not an everyday plan.
Then STOP and get the user's sign-off. Do NOT barrel from framing into estimation — the approval gate is the user's decision. (Trivial one-liners may be waived, but say so explicitly.)"
    ;;
  pre-analysis-plan)
    msg="The PAP is a confirmatory contract. Write it to a file and get the user's EXPLICIT approval before estimating — a PAP you drafted but never had signed off does not make the work confirmatory. After sign-off, route execution through causal-powers:executing-analysis-plans (don't hand-run the specs)."
    ;;
  structural-estimation)
    msg="Model card before machinery. Write primitives, per-parameter identification, the target counterfactual, and the estimation plan to a file and get the user's sign-off BEFORE building estimation code. A converged optimizer is not an identified model — name what identifies each parameter and plan the Monte-Carlo recovery test now, not after."
    ;;
  executing-analysis-plans)
    msg="Execution has a dependent spine (runs inline, in order) AND an independent fan-out (robustness specs, competing designs, subsample cuts, placebos, multiple outcomes; for structural work: recovery reps, starting values, per-mechanism counterfactuals). For the fan-out, ASK FIRST — present the execution-mode choice up front, do NOT silently pick: (a) INLINE — each chosen spec in turn, here, fully observable; or (b) SUBAGENT DISPATCH — one parallel subagent per spec via the shipped causal-powers:robustness-runner (superpowers dispatching-parallel-agents / subagent-driven-development for the mechanics). Recommend subagent dispatch for genuinely independent specs, but it is the user's call. Two guardrails on top: (1) the fan-out is BOUNDED — pick the ~3 checks that earn their place; 'cheap to run' is the trap, a wall of specs reads as weak identification, and choosing WHICH to run is itself an analysis-checkpoints decision, not a silent buffet. (2) End in result-verification before any result is written to a file. Whichever mode, each dispatched/run spec carries its exact recipe + the checkpoint rule."
    ;;
  causal-identification)
    msg="A regression coefficient is NOT a causal effect until the design earns it. Before reading the estimate causally, state the identification strategy and TEST its assumptions (parallel trends / first-stage strength / manipulation / balance / placebo / sensitivity — the design-specific suite is mandatory, not optional). Then route: design tested + robustness passed → invoke causal-powers:result-verification before reporting. A failed diagnostic or a needed design change → STOP and invoke causal-powers:analysis-checkpoints (the user decides, you don't redesign silently). Wrong sign/magnitude → rule out a data bug via causal-powers:wrong-number-debugging first. See this skill's 'When to Use' graph."
    ;;
  result-verification)
    msg="Verification is not the finish line — it forks. If any check FAILS (won't reconcile / won't reproduce / magnitude absurd) → STOP and invoke causal-powers:wrong-number-debugging (or analysis-checkpoints if the fix is a design change); do not footnote a failed check and ship. If all checks pass → invoke causal-powers:analysis-review to dispatch the independent reviewer for the silent-failure sweep BEFORE shipping, then causal-powers:project-organization to tidy scratch before committing. Don't end at 'the result is X'. See this skill's 'When to Use' graph."
    ;;
  data-contracts)
    msg="A clean run is not a correct number. If a reconciliation / total / join-cardinality assertion FAILS → STOP and invoke causal-powers:wrong-number-debugging to bisect to the exact bad step — don't patch and proceed. If the tempting 'fix' would drop/filter/winsorize rows, change a join's grain, or move a number the user has already seen → that's a sample/spec redesign: STOP and invoke causal-powers:analysis-checkpoints, don't smuggle it in. Otherwise freeze the validated result as a baseline and continue. See this skill's 'When to Use' graph."
    ;;
  data-preparation)
    msg="Cleaning is the analysis, not pre-analysis — plan it, don't barrel. You own the data-ingest-and-cleaning PHASE (Phase 1 of analysis-plan.md): decompose ingest → clean → join → dedup → recode → reconcile into a checkboxed sub-plan with a DECISIONS LOG, and write to disk after every couple of actions (it survives /clear + compaction and is the audit trail). You are the DOER; CALL causal-powers:data-contracts to validate every step (assert join cardinality before each merge, reconcile totals after) — don't hand-roll validation. HARD STOP: any drop / filter / winsorize / non-trivial dedup / recode-of-a-reported-grouping — or anything that moves a number the user has seen — is a sample/spec change → invoke causal-powers:analysis-checkpoints, the user's call, don't smuggle it in as tidying. A failed reconciliation → causal-powers:wrong-number-debugging. When Phase 1 is ticked and the clean dataset reconciles → return to causal-powers:executing-analysis-plans for construction/estimation. Trivial single clean file → state the waiver, skip the plan. See this skill's 'When to Use' graph."
    ;;
  *)
    exit 0
    ;;
esac

context="<system-reminder>
${msg}
</system-reminder>"

escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}
context_escaped=$(escape_for_json "$context")

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "PostToolUse",\n    "additionalContext": "%s"\n  }\n}\n' "$context_escaped"
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$context_escaped"
fi

exit 0
